@base = http://localhost:8080

### Register as car owner
POST {{base}}/users/register
Content-Type: application/json

{
  "username": "marie",
  "password": "marie123",
  "email": "marie@rentmycar.nl",
  "role": "OWNER"
}

### Register as renter
POST {{base}}/users/register
Content-Type: application/json

{
  "username": "jan",
  "password": "jan123",
  "email": "jan@rentmycar.nl",
  "role": "RENTER"
}

### Login as seeded owner Paul
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "paul",
  "password": "paul123"
}

> {% client.global.set("ownerToken", response.body.token); %}

### Login as seeded renter Lisa
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "lisa",
  "password": "lisa123"
}

> {% client.global.set("renterToken", response.body.token); %}

### Current logged-in user
GET {{base}}/users/me
Authorization: Bearer {{ownerToken}}

### All cars (public)
GET {{base}}/cars

### Only electric cars
GET {{base}}/cars?category=BEV

### Combustion cars up to 20 euro per daypart
GET {{base}}/cars?category=ICE&maxPricePerDaypart=20

### One car
GET {{base}}/cars/1

### Add a car as owner; the HTTP Client stores its id for the next requests
POST {{base}}/cars
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "category": "BEV",
  "brand": "Skoda",
  "model": "Elroq 85",
  "pricePerDaypart": 30.0,
  "fixedCostsPerYear": 3800.0,
  "consumptionPer100Km": 15.8
}

> {% client.global.set("carId", response.body.id); %}

### The new car
GET {{base}}/cars/{{carId}}

### Change the price of the new car
PUT {{base}}/cars/{{carId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "category": "BEV",
  "brand": "Skoda",
  "model": "Elroq 85",
  "pricePerDaypart": 27.5,
  "fixedCostsPerYear": 3800.0,
  "consumptionPer100Km": 15.8
}

### Costs for 15000 km per year (the default)
GET {{base}}/cars/{{carId}}/costs

### Costs for 25000 km per year
GET {{base}}/cars/{{carId}}/costs?kmPerYear=25000

### Renter cannot add a car → 403
POST {{base}}/cars
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "category": "BEV",
  "brand": "Kia",
  "model": "EV3",
  "pricePerDaypart": 25.0,
  "fixedCostsPerYear": 3000.0,
  "consumptionPer100Km": 15.0
}

### Delete the new car → 204
DELETE {{base}}/cars/{{carId}}
Authorization: Bearer {{ownerToken}}

### The deleted car is gone → 404
GET {{base}}/cars/{{carId}}

### Unknown id → 404
GET {{base}}/cars/999

### Id is not a number → 400
GET {{base}}/cars/abc

### Unknown category → 400
GET {{base}}/cars?category=STEAM

### Consumption must be greater than 0 → 400
POST {{base}}/cars
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "category": "BEV",
  "brand": "Kia",
  "model": "EV3",
  "pricePerDaypart": 25.0,
  "fixedCostsPerYear": 3000.0,
  "consumptionPer100Km": 0
}

### A combustion car needs a fuel type → 400
POST {{base}}/cars
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "category": "ICE",
  "brand": "Opel",
  "model": "Corsa",
  "pricePerDaypart": 14.0,
  "fixedCostsPerYear": 2000.0,
  "consumptionPer100Km": 5.0
}

### Book the Polo (car 1) as Lisa. Each day is two dayparts
POST {{base}}/reservations
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "carId": 1,
  "startDate": "2026-09-01",
  "endDate": "2026-09-03"
}

> {% client.global.set("reservationId", response.body.id); %}

### Lisa's reservations
GET {{base}}/reservations
Authorization: Bearer {{renterToken}}

### That booking
GET {{base}}/reservations/{{reservationId}}
Authorization: Bearer {{renterToken}}

### Paul confirms a booking of his own car
POST {{base}}/reservations/{{reservationId}}/confirm
Authorization: Bearer {{ownerToken}}

### The same days are taken → 400
POST {{base}}/reservations
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "carId": 1,
  "startDate": "2026-09-02",
  "endDate": "2026-09-02"
}

### Lisa cancels, which frees the car
POST {{base}}/reservations/{{reservationId}}/cancel
Authorization: Bearer {{renterToken}}

### Owner cannot book a car → 403
POST {{base}}/reservations
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "carId": 1,
  "startDate": "2026-10-01",
  "endDate": "2026-10-01"
}

### Unknown reservation → 404
GET {{base}}/reservations/999
Authorization: Bearer {{renterToken}}
